root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Kotlin style is shared by ktlint and Android Studio / IntelliJ IDEA.
[{*.kt,*.kts}]
ktlint_code_style = ktlint_official
indent_style = space
indent_size = 4
max_line_length = 140
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

# Compose UI functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Keep the wildcard imports this project already relies on.
ij_kotlin_packages_to_use_import_on_demand = android.app.*,android.content.*,androidx.compose.animation.core.*,androidx.compose.foundation.*,androidx.compose.foundation.layout.*,androidx.compose.material.icons.outlined.*,androidx.compose.material3.*,androidx.compose.runtime.*,androidx.compose.ui.test.*,androidx.work.*,kotlinx.coroutines.*,okhttp3.*,okhttp3.mockwebserver.*,org.junit.Assert.*
